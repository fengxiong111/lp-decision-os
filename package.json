{
  "name": "lp-decision-os",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "next build",
    "build:frontend": "vite build --config apps/frontend/vite.config.ts",
    "frontend:dev": "vite --config apps/frontend/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test tests/*.test.mjs && tsx --test tests/*.test.ts",
    "test": "npm run build && npm run build:frontend && npm run test:unit",
    "test:e2e": "node tests/playwright.e2e.mjs",
    "test:e2e:mobile-dashboard": "node tests/mobile-dashboard.e2e.mjs",
    "test:e2e:backend": "node tests/backend.e2e.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern '**/dist/**' --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:integrity": "tsx scripts/doctor.ts --database",
    "db:integrity:full": "LP_ALLOW_FULL_DB_INTEGRITY=1 tsx scripts/doctor.ts --full-database --database",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run test:e2e && npm run test:e2e:backend"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^8.2.0",
    "@fastify/websocket": "^11.2.0",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "0.45.2",
    "fastify": "^5.6.1",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@raydium-io/raydium-sdk-v2": "0.2.60-alpha",
    "@solana/web3.js": "1.98.4",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^5.0.2",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "playwright": "^1.62.1",
    "tailwindcss": "4.2.1",
    "tsx": "^4.20.5",
    "typescript": "5.9.3",
    "vite": "^7.1.3"
  },
  "type": "module"
}
